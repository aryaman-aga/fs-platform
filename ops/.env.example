# FS-Platform single-node configuration. Copy to ops/.env (git-ignored), fill in, chmod 600.
# Generate secrets with:   openssl rand -base64 48 | tr -d '\n'
# Generate 32-byte keys:   openssl rand -base64 32
# Never commit ops/.env, never paste it into tickets or chats. Rotate per docs/security/key-management.md.

# ---------------------------------------------------------------- site
FS_SITE_ADDRESS=fs.example-firm.in
ACME_EMAIL=it@example-firm.in
FS_VERSION=1.0.0
REGISTRY=local
# Space-separated networks (Caddy allow-lists); comma-separated variant for the API's ABAC rule.
FS_OFFICE_CIDRS_CADDY=10.10.0.0/16 192.168.10.0/24
FS_RENDER_WORKER_CIDRS=10.10.20.0/24
FSWEB_OFFICE_CIDRS=10.10.0.0/16,192.168.10.0/24
# Bind published ports to the LAN address only when Cloudflare Tunnel is used (e.g. 10.10.0.5).
FS_HTTPS_BIND=0.0.0.0
FS_HTTP_BIND=0.0.0.0
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- application secrets
FSWEB_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
# Envelope-encryption KEK (base64 of 32 bytes). Rotation: "k1:<old>,k2:<new>" — last entry is active.
FSWEB_KMS_MASTER_KEY=CHANGE_ME_openssl_rand_base64_32
# Shared secret of the Windows render pool (X-Worker-Token).
FSWEB_WORKER_TOKEN=CHANGE_ME_openssl_rand_base64_48
# .fspkg signing (Ed25519 seed, base64 32 bytes) and the public keys of trusted laptops (Mode C).
FSWEB_PKG_SIGNING_KEY=
FSWEB_PKG_TRUSTED_KEYS=
FSWEB_LOG_LEVEL=INFO

# ---------------------------------------------------------------- SSO (ADR-0003) — optional
FSWEB_OIDC_ISSUER=
FSWEB_OIDC_CLIENT_ID=
FSWEB_OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------- database (roles created by ops/postgres/initdb)
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
FSWEB_OWNER_PASSWORD=CHANGE_ME
FSWEB_APP_PASSWORD=CHANGE_ME
PGBACKREST_CIPHER_PASS=CHANGE_ME_split_with_shamir_2_of_3

# ---------------------------------------------------------------- object storage
MINIO_ROOT_USER=fs-minio-root
MINIO_ROOT_PASSWORD=CHANGE_ME
# MinIO SSE key: "<key-name>:<base64 32 bytes>", e.g. fs-sse:$(openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=fs-sse:CHANGE_ME
MINIO_APP_ACCESS_KEY=fs-app
MINIO_APP_SECRET_KEY=CHANGE_ME
FSWEB_S3_BUCKET=fs-objects
FS_FINALS_BUCKET=fs-finals
FS_FINALS_RETENTION_DAYS=2557
FSWEB_S3_REGION=ap-south-1

# ---------------------------------------------------------------- optional components
# Redis (profile `ha`): rate limits and short-lived locks shared by several API nodes.
REDIS_PASSWORD=
FSWEB_REDIS_URL=
# ClamAV (profile `av`): upload scanning.
FSWEB_CLAMD_SOCKET=
# AI reviewer (ADR-0008): disabled by default; region is mandatory when enabled.
FSWEB_AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_AWS_REGION=ap-south-1
# Tracing (E-OPS-02), profile `monitoring`.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- image pins (E-SEC-12)
# Production: pin every image BY DIGEST, e.g. postgres:16-bookworm@sha256:<digest>.
PYTHON_IMAGE=python:3.13-slim-trixie
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest
REDIS_IMAGE=redis:7.4-bookworm
CLAMAV_IMAGE=clamav/clamav:1.4
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.17.1
GRAFANA_IMAGE=grafana/grafana:12.0.2
LOKI_IMAGE=grafana/loki:3.5.0
ALLOY_IMAGE=grafana/alloy:latest
TEMPO_IMAGE=grafana/tempo:2.8.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.128.0

# ---------------------------------------------------------------- scale
FS_WORKER_REPLICAS=2
