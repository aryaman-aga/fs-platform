# FS-Platform edge: TLS 1.2+/HSTS, security headers, rate limits, IP allow-lists, SPA + API proxy.
# Requires Caddy built with github.com/mholt/caddy-ratelimit (see ops/docker/ui.Dockerfile).
#
# Environment (from docker compose):
#   FS_SITE_ADDRESS         e.g. fs.example-firm.in
#   ACME_EMAIL              contact for the certificate authority (optional)
#   FS_OFFICE_CIDRS         space-separated office networks allowed to reach /api/v1/admin and /grafana
#   FS_RENDER_WORKER_CIDRS  networks of the Windows render pool allowed to reach /api/v1/internal
{
	email {$ACME_EMAIL}
	order rate_limit before basic_auth
	servers {
		# Cloudflare Tunnel / the local docker network sit in private ranges; trust their forwarded client IP.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		protocols h1 h2
	}
	# Caddy's own admin API stays on localhost inside the container.
	admin localhost:2019
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}
}

{$FS_SITE_ADDRESS} {
	tls {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	import security_headers

	# ---------------------------------------------------------------- never exposed
	respond /metrics 404
	respond /api/v1/internal/render/metrics 404

	# ---------------------------------------------------------------- allow-lists (05 §1, E-SEC-02)
	@admin_outside_office {
		path /api/v1/admin /api/v1/admin/*
		not client_ip {$FS_OFFICE_CIDRS}
	}
	respond @admin_outside_office "Forbidden: administration is allowed from office networks only" 403

	@internal_outside_pool {
		path /api/v1/internal/*
		not client_ip {$FS_RENDER_WORKER_CIDRS}
	}
	respond @internal_outside_pool 404

	@grafana_outside_office {
		path /grafana /grafana/*
		not client_ip {$FS_OFFICE_CIDRS}
	}
	respond @grafana_outside_office 404

	# ---------------------------------------------------------------- request size limits
	@uploads path_regexp uploads ^/api/v1/(engagements/[^/]+/files|internal/render/[^/]+/complete|engagements/import)
	request_body @uploads {
		max_size 210MB
	}
	@api_other {
		path /api/*
		not path_regexp ^/api/v1/(engagements/[^/]+/files|internal/render/[^/]+/complete|engagements/import)
	}
	request_body @api_other {
		max_size 2MB
	}

	# ---------------------------------------------------------------- rate limits (no CAPTCHA, 05 §1)
	rate_limit {
		zone auth {
			match {
				path /api/v1/auth/*
			}
			key {client_ip}
			events 20
			window 1m
		}
		zone api {
			match {
				path /api/*
			}
			key {client_ip}
			events 600
			window 1m
		}
	}

	# ---------------------------------------------------------------- routes
	handle /api/* {
		reverse_proxy {
			# Every API replica is discovered through Docker DNS (one replica single-node, 2+ in the HA overlay).
			dynamic a {
				name api
				port 8000
				refresh 10s
			}
			header_up X-Request-ID {http.request.uuid}
			lb_policy least_conn
			lb_try_duration 5s
			# Passive health checks (active checks are not available with dynamic upstreams).
			fail_duration 30s
			max_fails 3
			unhealthy_status 502 503 504
			# Server-sent events (run progress) must not be buffered.
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		root * /srv/fsui
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# ---------------------------------------------------------------- access log without secrets
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Worker-Token delete
				request>headers>X-Csrf-Token delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>uri regexp "/(share|invites|reset)/[^/?]+" "/$1/REDACTED"
				request>uri query {
					delete token
					delete code
					delete state
				}
			}
		}
	}
}

# Plain HTTP only redirects (Caddy does this automatically for the site above).
