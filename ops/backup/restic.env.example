# restic targets for the backup container (copy to ops/backup/restic.env, chmod 600).
# 3-2-1-1-0 (07 §1): copy 1 = live volumes, copy 2 = NAS (other medium, other VLAN),
# copy 3 = off-site India-region object storage with OBJECT LOCK (the immutable copy).
#
# The repository passwords are the backup encryption keys: generate with
#   openssl rand -base64 48 > nas.pass && openssl rand -base64 48 > offsite.pass
# and split each with Shamir 2-of-3 among the partners (tools/shamir.py, E-BCP-02).

# --- on-site NAS (separate VLAN, snapshots enabled on the NAS itself)
RESTIC_REPOSITORY_NAS=sftp:fsbackup@nas.example-firm.lan:/volume1/fs-platform-restic
RESTIC_PASSWORD_FILE_NAS=/run/secrets/restic-nas.pass

# --- off-site, India region, bucket created WITH object lock (compliance mode, 30-day default retention)
RESTIC_REPOSITORY_OFFSITE=s3:https://s3.ap-south-1.amazonaws.com/example-firm-fs-backup
RESTIC_PASSWORD_FILE_OFFSITE=/run/secrets/restic-offsite.pass
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ap-south-1

# --- retention (restic forget): 48 hourly, 35 daily, 12 monthly, 8 yearly
RESTIC_KEEP_HOURLY=48
RESTIC_KEEP_DAILY=35
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=8
# Object-locked snapshots cannot be pruned before the lock expires: keep this >= the bucket's
# default retention so prune never fights the lock.
RESTIC_MIN_AGE_DAYS_OFFSITE=31

METRICS_DIR=/metrics
