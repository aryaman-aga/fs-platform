[Unit]
Description=FS-Platform pgBackRest weekly full backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=FS_HOME=/opt/fs-platform
Environment=METRICS_DIR=/var/lib/node_exporter/textfile
Environment=FS_EVIDENCE_DIR=/var/lib/fs-platform/evidence
ExecStart=/opt/fs-platform/ops/backup/pgbackrest-backup.sh full
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
