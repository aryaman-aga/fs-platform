# FS-Platform web platform — example environment (copy to .env; never commit real values).
# dev | test | prod | offline   (prod and offline refuse insecure settings at start-up)
FSWEB_ENV=prod

# PostgreSQL: owner role runs migrations; the runtime role is subject to row-level security.
FSWEB_DATABASE_URL=postgresql+psycopg://fsweb_owner:CHANGE_ME@db:5432/fsweb
FSWEB_APP_DATABASE_URL=postgresql+psycopg://fsweb_app:CHANGE_ME@db:5432/fsweb
# FSWEB_DB_APP_ROLE=fsweb_app            # role granted runtime privileges by the migration

# Object storage: local:/path (single node, offline) or s3://bucket (MinIO / S3, versioning + object lock)
FSWEB_STORAGE=s3://fs-objects
FSWEB_S3_ENDPOINT=http://minio:9000
FSWEB_S3_ACCESS_KEY=CHANGE_ME
FSWEB_S3_SECRET_KEY=CHANGE_ME
FSWEB_S3_REGION=ap-south-1

# Secrets: 32+ random characters; KMS key-encryption keys as base64 of 32 bytes.
# Rotation: list several as id:key,id:key — the last one is active (python -m fsweb.manage rotate-kek).
FSWEB_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
FSWEB_KMS_MASTER_KEY=k1:CHANGE_ME_BASE64_32_BYTES
# FSWEB_PKG_SIGNING_KEY=base64-ed25519-seed     # .fspkg signing key (derived from the secret if unset)
# FSWEB_PKG_TRUSTED_KEYS=base64-pubkey,base64-pubkey

FSWEB_COOKIE_SECURE=true
FSWEB_PUBLIC_BASE_URL=https://fs.example-firm.in
FSWEB_ALLOWED_ORIGINS=
FSWEB_TRUST_PROXY=true
# Administrative actions only from these networks (05 §1 IP allow-list)
FSWEB_OFFICE_CIDRS=10.0.0.0/8

# Optional SSO for firm users (OIDC: Microsoft Entra ID / Google Workspace)
FSWEB_OIDC_ISSUER=
FSWEB_OIDC_CLIENT_ID=
FSWEB_OIDC_CLIENT_SECRET=
FSWEB_OIDC_REDIRECT_URI=https://fs.example-firm.in/api/v1/auth/oidc/callback

# Optional shared rate limiting for several API nodes
FSWEB_REDIS_URL=

FSWEB_WORK_DIR=/var/lib/fsweb/work
FSWEB_AUDIT_HEAD_DIR=/var/lib/fsweb/audit-heads
# Windows render workers authenticate with this shared secret (X-Worker-Token)
FSWEB_WORKER_TOKEN=CHANGE_ME
# AI review stays off unless enabled here and for the firm / engagement (approval-gated)
FSWEB_AI_ENABLED=false
# FSWEB_ENGINE=real                       # fake = deterministic engine double (tests / demos)
# FSWEB_SERVE_UI=/opt/fs-platform/fsui/dist  # serve the built SPA from the API (offline edition)
# FSWEB_ALEMBIC_DIR=                      # override the packaged migration scripts
# FSWEB_CLAMD_SOCKET=/run/clamav/clamd.ctl
# FSWEB_SMTP_HOST= / FSWEB_SMTP_PORT=587 / FSWEB_SMTP_USER= / FSWEB_SMTP_PASSWORD= / FSWEB_SMTP_FROM=
# FSWEB_WORKER_METRICS_PORT=9101          # worker /metrics (run durations)
FSWEB_LOG_LEVEL=INFO
